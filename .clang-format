# id Software style (Doom 3 coding standard), machine-enforced.
---
Language: Cpp
Standard: Latest

# 4 spaces per indent level; no tabs (existing tabs are converted at width 4).
UseTab: Never
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 4
AccessModifierOffset: -4

# id code does not hard-wrap; keep lines sane (~120) by hand.
ColumnLimit: 0

# Trailing braces everywhere; else cuddles the closing brace.
BreakBeforeBraces: Attach

# if ( x ) { ... } — padded parens, space after control keywords.
SpaceBeforeParens: ControlStatements
SpacesInParentheses: false
SpacesInCStyleCastParentheses: false
SpaceAfterCStyleCast: false
SpacesInSquareBrackets: false
SpaceBeforeSquareBrackets: false
SpacesInContainerLiterals: true

# One statement per line, always.
AllowShortBlocksOnASingleLine: Empty
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: true
AllowShortLambdasOnASingleLine: Inline

IndentCaseLabels: true

# Column alignment of declarations (type | name), id-style.
AlignConsecutiveDeclarations: Consecutive
AlignConsecutiveAssignments: None
AlignConsecutiveMacros: Consecutive
AlignTrailingComments: true

# The * belongs to the type column, but binds right: const float *p;
PointerAlignment: Right
DerivePointerAlignment: false

# Include order is meaningful (precompiled/idlib header first).
SortIncludes: Never

# Never touch the /*==== function header blocks.
ReflowComments: false

KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 2
NamespaceIndentation: None
FixNamespaceComments: true
Cpp11BracedListStyle: false
SpaceBeforeCpp11BracedList: true
