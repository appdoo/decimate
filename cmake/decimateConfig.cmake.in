@PACKAGE_INIT@

# All decimate component targets (and pure-math) live in one exported targets file.
include("${CMAKE_CURRENT_LIST_DIR}/decimateTargets.cmake")

# Resolve find_package(decimate COMPONENTS ...) — each component is a namespaced
# target decimate::<comp> carried by the targets file above.
foreach(_comp ${decimate_FIND_COMPONENTS})
    if(TARGET decimate::${_comp})
        set(decimate_${_comp}_FOUND TRUE)
    else()
        set(decimate_${_comp}_FOUND FALSE)
    endif()
endforeach()

check_required_components(decimate)
