# id Software style (Doom 3 coding standard): names and method size.
# Installed by /sdd:coding-style. Needs compile_commands.json to run.
Checks: '-*,readability-identifier-naming,readability-function-size,cppcoreguidelines-narrowing-conversions'
CheckOptions:
  # method bodies: one screen, three levels
  readability-function-size.LineThreshold: 100
  readability-function-size.NestingThreshold: 3
  # naming: the project's existing convention (kept from the previous .clang-tidy), not the id lineage
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.EnumConstantIgnoredRegexp: 'k[A-Z].*'
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.MethodCase: camelBack
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.MemberCase: camelBack
  readability-identifier-naming.PrivateMemberCase: camelBack
  readability-identifier-naming.PrivateMemberSuffix: '_'
  readability-identifier-naming.ProtectedMemberCase: camelBack
  readability-identifier-naming.ProtectedMemberSuffix: '_'
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: 'k'
  # k-prefix only for NAMED constants (namespace, class or static scope). A local constexpr/const
  # is a variable (x1 next to x2, x3 in a formula), so no ConstexprVariable rule.
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: 'k'
  readability-identifier-naming.LocalConstantCase: camelBack
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.StaticConstantPrefix: 'k'
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
